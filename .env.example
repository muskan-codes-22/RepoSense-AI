# Required: NVIDIA API key for AI-powered analysis
# Get yours at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Optional: GitHub Personal Access Token to avoid API rate limits
# Create one at https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# Optional: Supabase credentials for persistent analysis history
# The app works fully without Supabase (uses local-only state)
# Create a project at https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
